# ---- App ----
SECRET_KEY=change-me
TOKEN_TTL_HOURS=12
DATABASE_PATH=./data/recruit.db
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173
SYNC_PROCESSING=0

# ---- LLM (any OpenAI-compatible chat endpoint) ----
# Groq:    https://api.groq.com/openai/v1          model: llama-3.3-70b-versatile
# OpenAI:  https://api.openai.com/v1               model: gpt-4o-mini
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai   model: gemini-2.0-flash
# Ollama:  http://localhost:11434/v1  (API key can be any string)   model: llama3.1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ---- Embeddings: hash | st | openai ----
# hash   = built-in hashed TF vectors (offline, mostly lexical)
# st     = sentence-transformers (pip install sentence-transformers), true semantic
# openai = any OpenAI-compatible /embeddings endpoint
EMBEDDING_BACKEND=hash
ST_MODEL=all-MiniLM-L6-v2
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Email (optional). Without SMTP, emails are stored in the `outbox` table ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=recruiting@example.com
